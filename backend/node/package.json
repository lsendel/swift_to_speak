{
  "name": "voiceflow-ai-backend",
  "version": "1.0.0",
  "description": "Real-time voice processing pipeline backend",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
